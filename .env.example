# Docker Compose configuration for CrediTrack.
#
# Copy this file to `.env` in the same folder (project root) and fill in
# real values before running `docker compose up`. Docker Compose reads a
# file named exactly `.env` automatically — you never pass it on the
# command line.
#
# This is SEPARATE from server/.env, which is only used by the older,
# non-Docker workflow (`npm start` run directly inside server/). If you're
# using Docker, this file is the one that matters.

# Postgres superuser password — used once, on first startup, to provision
# the app's own database and roles (see server/db/init/01-provision-roles.sh).
POSTGRES_SUPERUSER_PASSWORD=postgres

# Passwords for the two app-specific Postgres roles this app creates for
# itself (see server/db/provision-roles.sql for what each one is allowed to
# do). Change both to something real before this runs anywhere but your own
# laptop.
CREDITTRACK_MIGRATOR_PASSWORD=change-me-migrator
CREDITTRACK_APP_PASSWORD=change-me-app

# The initial password for the starter account (username `kumaresan`) —
# same idea as FAMILY_ACCESS_KEY in server/.env, just for the Docker build.
# Only used ONCE, the very first time the backend starts against a
# completely empty database (it creates the `kumaresan` account with this
# as its password, then this value is ignored from then on) — see
# DOCKER.md's "Changing the username or password" for how to change either
# one after that; editing this value later and restarting does nothing.
# Registration is open on this app, so visitors don't need this account at
# all — they can just create their own from the sign-in screen.
FAMILY_ACCESS_KEY=change-me
