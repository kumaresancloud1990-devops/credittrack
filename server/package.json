{
  "name": "credittrack-server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for CrediTrack (Node.js + Express + Postgres, no build step).",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "migrate": "node-pg-migrate up --envPath .env --schema credittrack --migrations-schema credittrack",
    "migrate:down": "node-pg-migrate down --envPath .env --schema credittrack --migrations-schema credittrack",
    "migrate:create": "node-pg-migrate create --envPath .env",
    "seed": "node db/seed.js",
    "set-password": "node scripts/set-password.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.9.1"
  },
  "overrides": {
    "glob": "^11.1.0"
  }
}
